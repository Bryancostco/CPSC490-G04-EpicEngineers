# Copy this file to prototype/.env and fill in the values locally.
# Never commit .env. Credentials come only through the SonarX Slack channel.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
# Optional: only set this if SonarX gives us a role to use.
SNOWFLAKE_ROLE=
